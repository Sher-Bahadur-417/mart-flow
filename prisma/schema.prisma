generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
  CREDIT
  STORE_CREDIT
}

enum SaleStatus {
  COMPLETED
  RETURNED
  PARTIALLY_RETURNED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  COMPLETED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  DAMAGE
  LOSS
  ADJUSTMENT
}

enum RefundMethod {
  CASH
  CARD
  STORE_CREDIT
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  auditLogs          AuditLog[]
  settings           Setting[]
  categories         Category[]
  brands             Brand[]
  units              Unit[]
  products           Product[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  stockAdjustments   StockAdjustment[]
  customers          Customer[]
  customerPayments   CustomerPayment[]
  suppliers          Supplier[]
  supplierPayments   SupplierPayment[]
  sales              Sale[]
  heldCarts          HeldCart[]
  returns            Return[]
  purchases          Purchase[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  employees          Employee[]
  notifications      Notification[]
  counters           Counter[]
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model User {
  id           String    @id @default(cuid())
  storeId      String?
  roleId       String
  name         String
  email        String    @unique
  passwordHash String
  username     String    @unique
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store              Store?              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  role               Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs          AuditLog[]
  employee           Employee?
  grants             UserPermission[]
  sales              Sale[]              @relation("SaleCashier")
  heldCarts          HeldCart[]
  returns            Return[]            @relation("ReturnCashier")
  purchases          Purchase[]          @relation("PurchaseCreator")
  expenses           Expense[]
  notifications      Notification[]
  inventoryMovements InventoryMovement[]
  stockAdjustments   StockAdjustment[]
  customerPayments   CustomerPayment[]
  supplierPayments   SupplierPayment[]

  @@index([storeId])
  @@index([roleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  storeId   String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

model Setting {
  id      String @id @default(cuid())
  storeId String
  key     String
  value   String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}

model Counter {
  storeId String
  key     String
  value   Int    @default(0)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, key])
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, slug])
}

model Brand {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, name])
}

model Unit {
  id           String    @id @default(cuid())
  storeId      String
  name         String
  abbreviation String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([storeId, abbreviation])
}

model Product {
  id            String    @id @default(cuid())
  storeId       String
  name          String
  sku           String
  categoryId    String?
  brandId       String?
  unitId        String?
  purchasePrice Decimal   @db.Decimal(14, 2)
  sellingPrice  Decimal   @db.Decimal(14, 2)
  taxRate       Decimal   @default(0) @db.Decimal(5, 2)
  discount      Decimal   @default(0) @db.Decimal(14, 2)
  minStock      Decimal   @default(0) @db.Decimal(14, 3)
  maxStock      Decimal?  @db.Decimal(14, 3)
  expiryDate    DateTime?
  imageUrl      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  barcodes           ProductBarcode[]
  inventory          Inventory?
  movements          InventoryMovement[]
  adjustments        StockAdjustment[]
  saleItems          SaleItem[]
  returnItems        ReturnItem[]
  purchaseItems      PurchaseItem[]

  @@unique([storeId, sku])
  @@index([storeId, name])
  @@index([categoryId])
}

model ProductBarcode {
  id        String  @id @default(cuid())
  storeId   String
  productId String
  code      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([productId])
}

model Inventory {
  id        String   @id @default(cuid())
  storeId   String
  productId String   @unique
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model InventoryMovement {
  id            String                 @id @default(cuid())
  storeId       String
  productId     String
  type          InventoryMovementType
  quantity      Decimal                @db.Decimal(14, 3)
  reason        String?
  referenceType String?
  referenceId   String?
  createdById   String
  createdAt     DateTime               @default(now())
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy     User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([productId])
  @@index([referenceType, referenceId])
}

model StockAdjustment {
  id             String   @id @default(cuid())
  storeId        String
  productId      String
  quantityBefore Decimal  @db.Decimal(14, 3)
  quantityAfter  Decimal  @db.Decimal(14, 3)
  reason         String
  createdById    String
  createdAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model Customer {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  phone          String?
  email          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  creditLimit    Decimal? @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payments       CustomerPayment[]
  sales          Sale[]
  heldCarts      HeldCart[]
  returns        Return[]

  @@index([storeId, name])
  @@index([storeId, phone])
}

model CustomerPayment {
  id          String        @id @default(cuid())
  storeId     String
  customerId  String
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  note        String?
  createdById String
  createdAt   DateTime      @default(now())
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model Supplier {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  phone          String?
  email          String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payments       SupplierPayment[]
  purchases      Purchase[]

  @@index([storeId, name])
}

model SupplierPayment {
  id          String        @id @default(cuid())
  storeId     String
  supplierId  String
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  note        String?
  createdById String
  createdAt   DateTime      @default(now())
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model Sale {
  id            String     @id @default(cuid())
  storeId       String
  invoiceNumber String
  cashierId     String
  customerId    String?
  status        SaleStatus @default(COMPLETED)
  subtotal      Decimal    @db.Decimal(14, 2)
  discountTotal Decimal    @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(14, 2)
  total         Decimal    @db.Decimal(14, 2)
  paidAmount    Decimal    @default(0) @db.Decimal(14, 2)
  creditAmount  Decimal    @default(0) @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime   @default(now())
  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier       User       @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  payments      SalePayment[]
  returns       Return[]

  @@unique([storeId, invoiceNumber])
  @@index([storeId, createdAt])
  @@index([cashierId])
  @@index([customerId])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  productId  String
  name       String
  sku        String
  quantity   Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal  @db.Decimal(14, 2)
  costPrice  Decimal  @db.Decimal(14, 2)
  discount   Decimal  @default(0) @db.Decimal(14, 2)
  tax        Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal  Decimal  @db.Decimal(14, 2)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]
}

model SalePayment {
  id     String        @id @default(cuid())
  saleId String
  method PaymentMethod
  amount Decimal       @db.Decimal(14, 2)
  sale   Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model HeldCart {
  id          String   @id @default(cuid())
  storeId     String
  cashierId   String
  customerId  String?
  label       String?
  payload     Json
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier     User     @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([storeId, cashierId])
}

model Return {
  id          String   @id @default(cuid())
  storeId     String
  saleId      String
  cashierId   String
  customerId  String?
  total       Decimal  @db.Decimal(14, 2)
  note        String?
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  cashier     User     @relation("ReturnCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       ReturnItem[]
  refunds     Refund[]
}

model ReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  saleItemId String
  productId  String
  quantity   Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal  @db.Decimal(14, 2)
  lineTotal  Decimal  @db.Decimal(14, 2)
  return     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Refund {
  id       String       @id @default(cuid())
  returnId String
  method   RefundMethod
  amount   Decimal      @db.Decimal(14, 2)
  return   Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Purchase {
  id          String         @id @default(cuid())
  storeId     String
  supplierId  String
  number      String
  status      PurchaseStatus @default(DRAFT)
  subtotal    Decimal        @default(0) @db.Decimal(14, 2)
  total       Decimal        @default(0) @db.Decimal(14, 2)
  note        String?
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       PurchaseItem[]

  @@unique([storeId, number])
  @@index([storeId, status])
}

model PurchaseItem {
  id               String   @id @default(cuid())
  purchaseId       String
  productId        String
  quantityOrdered  Decimal  @db.Decimal(14, 3)
  quantityReceived Decimal  @default(0) @db.Decimal(14, 3)
  unitCost         Decimal  @db.Decimal(14, 2)
  lineTotal        Decimal  @db.Decimal(14, 2)
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([storeId, name])
}

model Expense {
  id          String           @id @default(cuid())
  storeId     String
  categoryId  String
  amount      Decimal          @db.Decimal(14, 2)
  date        DateTime
  method      PaymentMethod
  description String?
  createdById String
  createdAt   DateTime         @default(now())
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([storeId, date])
}

model Employee {
  id           String    @id @default(cuid())
  storeId      String
  userId       String    @unique
  employeeCode String
  phone        String?
  jobTitle     String?
  hireDate     DateTime?
  salary       Decimal?  @db.Decimal(14, 2)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([storeId, employeeCode])
  @@index([storeId, isActive])
}

model Notification {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, isRead])
  @@index([userId])
}
